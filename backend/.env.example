GROQ_API_KEY=tu_api_key_aqui
GROQ_MODEL=llama-3.3-70b-versatile

# Google Drive
GOOGLE_DRIVE_FOLDER_ID=id_de_la_carpeta_raiz

# OAuth de usuario. Primera ejecución abre navegador y crea token_drive.json.
# En Render usar JSON inline como variables secretas:
GOOGLE_OAUTH_CLIENT_JSON={"installed":{}}
GOOGLE_OAUTH_TOKEN_JSON={"token":"...","refresh_token":"..."}
GOOGLE_OAUTH_CLIENT_FILE=C:\ruta\a\credenciales_OAuth.json
GOOGLE_OAUTH_TOKEN_FILE=token_drive.json

# Alternativa antigua para lectura: cuenta de servicio.
# Para desarrollo local puede usarse ruta de archivo en lugar de JSON inline:
GOOGLE_SERVICE_ACCOUNT_FILE=C:\ruta\a\flucito-credenciales.json
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
