# Proveedores LLM
GROQ_API_KEY=pega_aqui_tu_clave_de_groq
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=pega_aqui_tu_clave_de_openai
OPENAI_MODEL=gpt-5.6-luna
LLM_PRIMARY_PROVIDER=groq
LLM_FALLBACK_ENABLED=true

# Google Drive: carpeta raíz donde se guardan documentos y reportes
GOOGLE_DRIVE_FOLDER_ID=pega_aqui_el_id_de_la_carpeta

# OAuth recomendado para Drive en Render.
# Pega el JSON completo en una sola línea.
GOOGLE_OAUTH_CLIENT_JSON=
GOOGLE_OAUTH_TOKEN_JSON=

# Uso local alternativo: archivo OAuth/token en backend.
GOOGLE_OAUTH_CLIENT_FILE=
GOOGLE_OAUTH_TOKEN_FILE=token_drive.json

# Alternativa: cuenta de servicio. No combinar con OAuth.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=

# Carpeta local de documentos y estado del almacén
# Por defecto: backend/datos/almacen
ALMACEN_CARPETA_DATOS=
