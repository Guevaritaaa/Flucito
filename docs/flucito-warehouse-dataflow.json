{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "Flucito · Flujo de datos del almacén",
    "subtitle": "Documentos de entrada hasta la base acumulativa de Excel",
    "output": "flucito-warehouse-dataflow.html",
    "viewBox": [1080, 600],
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "views": [
      { "id": "document-intake", "label": "Entrada documental", "focus": ["usuario", "drive", "documentos"], "note": "Los documentos originales llegan desde la interfaz y se conservan en Drive." },
      { "id": "cfdi-processing", "label": "Procesamiento CFDI", "focus": ["documentos", "procesador", "catalogo"], "note": "El procesador extrae datos del XML y usa PDF/TXT como apoyo cuando existen." },
      { "id": "warehouse-report", "label": "Reporte de almacén", "focus": ["procesador", "excel", "api"], "note": "Los productos se acumulan en Excel y FastAPI expone la descarga." }
    ]
  },
  "stages": [
    { "label": "Entrada" },
    { "label": "Documentos" },
    { "label": "Procesamiento" },
    { "label": "Salida" }
  ],
  "nodes": [
    { "id": "usuario", "type": "external", "label": "Usuario", "sublabel": "carga docs", "stage": 0, "row": 0 },
    { "id": "drive", "type": "cloud", "label": "Google Drive", "sublabel": "documentos originales", "stage": 1, "row": 0, "tag": "XML · PDF · TXT" },
    { "id": "documentos", "type": "external", "label": "XML / PDF / TXT", "sublabel": "facturas y apoyo", "stage": 1, "row": 1 },
    { "id": "procesador", "type": "backend", "label": "Procesador almacén", "sublabel": "extrae y normaliza", "stage": 2, "row": 1, "tag": "CFDI 4.0" },
    { "id": "catalogo", "type": "backend", "label": "Catálogo", "sublabel": "apoyo para coincidencias", "stage": 2, "row": 2, "width": 150 },
    { "id": "excel", "type": "database", "label": "Excel acumulativo", "sublabel": "base acumulativa", "stage": 3, "row": 1, "tag": "XLSX · almacén" },
    { "id": "api", "type": "backend", "label": "FastAPI", "sublabel": "endpoint de descarga", "stage": 3, "row": 2 }
  ],
  "flows": [
    { "id": "upload-drive", "from": "usuario", "to": "drive", "label": "subir documentos", "classification": "entrada", "variant": "emphasis", "route": "straight" },
    { "id": "drive-documents", "from": "drive", "to": "documentos", "label": "leer archivos", "classification": "fuentes originales", "variant": "default", "route": "vertical-channel" },
    { "id": "direct-documents", "from": "usuario", "to": "documentos", "label": "carga directa", "classification": "multipart", "variant": "dashed", "route": "bottom-channel" },
    { "id": "documents-processor", "from": "documentos", "to": "procesador", "label": "extraer CFDI", "classification": "XML principal", "variant": "emphasis", "route": "vertical-channel", "labelAt": [360, 314] },
    { "id": "catalog-support", "from": "catalogo", "to": "procesador", "label": "coincidencias", "classification": "apoyo", "variant": "dashed", "route": "vertical-channel" },
    { "id": "processor-excel", "from": "procesador", "to": "excel", "label": "entradas", "classification": "acumulativo", "variant": "emphasis", "route": "vertical-channel", "labelAt": [560, 428] },
    { "id": "excel-api", "from": "excel", "to": "api", "label": "archivo generado", "classification": "descarga", "variant": "emphasis", "route": "vertical-channel" }
  ]
}
